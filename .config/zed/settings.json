// Zed Settings: https://zed.dev/docs/reference/all-settings
{
  "agent": {
    "dock": "right",
    "favorite_models": [
      {
        "provider": "zed.dev",
        "model": "claude-sonnet-5-5",
        "enable_thinking": true,
        "effort": "medium",
      },
      {
        "provider": "zed.dev",
        "model": "claude-haiku-5-5",
        "enable_thinking": true,
        "effort": "medium",
      },
      {
        "provider": "zed.dev",
        "model": "gpt-6.1-sol",
        "enable_thinking": true,
        "effort": "medium",
      },
      {
        "provider": "zed.dev",
        "model": "gpt-6-luna",
        "enable_thinking": true,
        "effort": "medium",
      },
      {
        "provider": "zed.dev",
        "model": "gemini-4-argon",
        "enable_thinking": true,
        "effort": "HIGH",
      },
      {
        "provider": "zed.dev",
        "model": "gemini-3.8-flash",
        "enable_thinking": true,
        "effort": "HIGH",
      },
    ],
    "model_parameters": [],
  },
  "auto_install_extensions": {
    "html": true,
    "catppuccin": true,
    "catppuccin-icons": true,
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 1000,
    },
  },
  "base_keymap": "Zed",
  "vim_mode": false,
  "outline_panel": {
    "dock": "left",
    "indent_size": 12,
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "git_panel": {
    "dock": "left",
  },
  "project_panel": {
    "dock": "left",
    "indent_size": 12,
    "git_status_indicator": true,
    "auto_fold_dirs": true,
  },
  "terminal": {
    "font_family": "FiraCode Nerd Font",
    "font_size": 14,
  },
  "tabs": {
    "git_status": true,
    "file_icons": true,
  },
  "tab_bar": {
    "show_nav_history_buttons": false,
  },
  "markdown_preview": {
    "limit_content_width": false,
  },
  "theme": {
    "mode": "dark",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Mocha",
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Mocha",
  },
  "buffer_font_size": 14,
  "buffer_font_features": {
    "calt": true,
  },
  "lsp": {
    "jdtls": {
      "settings": {
        "java_home": "C:\\Program Files\\Java\\jdk-25",
        "lombok_support": true,
      },
    },
  },
}
